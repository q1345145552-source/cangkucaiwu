# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 生成强随机值示例：python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# JWT 签名密钥 —— 必须是长随机字符串，泄露=任何人可伪造登录令牌
SECRET_KEY=please-generate-a-long-random-value

# 数据库口令 —— 生产环境务必改成强口令
POSTGRES_PASSWORD=please-change-me

# 首次 seed 时超级管理员及各仓库账号的初始密码
# 不设置则 seed 会随机生成并打印到容器日志
SEED_ADMIN_PASSWORD=please-change-me
