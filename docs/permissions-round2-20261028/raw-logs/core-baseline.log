    def test_all_hr_endpoints(tmp_path,monkeypatch,method,path,module,body,uid,granted):
        async def run():
            async with hr_environment(tmp_path,monkeypatch) as (_,factory,client):
                if granted:
                    permissions=[MENU_PERMISSIONS_BY_KEY[module].label]
