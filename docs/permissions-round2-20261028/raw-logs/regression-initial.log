                    assert response.status_code == 403, response.text
                    assert response.json()['detail'] == '只能使用申报所属仓库的客户'
                # 伪造仓库请求头不能扩大仓库范围。
                result = await client.get('/api/v1/customers', headers={**auth(uid),'X-Warehouse-ID':'2'})
